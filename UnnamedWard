if not game:IsLoaded() then game.Loaded:Wait() end

if getgenv and getgenv().UnnamedWardUnload then
    pcall(getgenv().UnnamedWardUnload)
end

local BASE = "https://raw.githubusercontent.com/UnnamedScriptsOfficial/UnnamedWard/refs/heads/main/"

local WISHLIST_URL   = BASE .. "wishlist.json"
local BLACKLIST_URL  = BASE .. "blacklist.json"
local FREE_URL       = BASE .. "free.json"
local DISCORD_INVITE = "https://discord.gg/g7jj8F6suv"
local KEY_GATE_URL   = BASE .. "keysystem.lua"

local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")
local LocalPlayer      = Players.LocalPlayer

local PlayerGui
pcall(function() PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 5) end)

local isMobile = UserInputService.TouchEnabled
    and not UserInputService.KeyboardEnabled
    and not UserInputService.MouseEnabled

local function getGuiParent()
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    local ok, gui = pcall(function() return CoreGui end)
    if ok and gui then return gui end
    return PlayerGui
end

local function runKeyGate()
    if type(loadstring) ~= "function" then
        warn("[UnnamedWard] loadstring unavailable -- cannot open key gate.")
        return false, "FREE"
    end
    local fetchOk, src = pcall(function() return game:HttpGet(KEY_GATE_URL) end)
    if not fetchOk or type(src) ~= "string" or #src < 100 then
        warn("[UnnamedWard] Could not fetch key gate source.")
        return false, "FREE"
    end
    getgenv().UnnamedWardGateCtx = {
        Wishlist = WISHLIST_URL, Blacklist = BLACKLIST_URL, Free = FREE_URL,
        Discord = DISCORD_INVITE, PlayerGui = PlayerGui, isMobile = isMobile,
        KeyVerified = false, GateClosed = false, Tier = "FREE",
    }
    getgenv().UnnamedWardKeyVerified = false
    getgenv().UnnamedWardPremium     = false
    getgenv().UnnamedWardTier        = "FREE"
    getgenv().UnnamedWardGateClosed  = false

    local fn, compileErr = loadstring(src)
    if not fn then
        warn("[UnnamedWard] Key gate compile error: " .. tostring(compileErr))
        getgenv().UnnamedWardGateClosed = true
        return false, "FREE"
    end
    local runOk, runErr = pcall(fn)
    if not runOk then
        warn("[UnnamedWard] Key gate runtime error: " .. tostring(runErr))
    end
    local startT, HARD_CAP, SOFT_CAP = tick(), 1800, 300
    while getgenv().UnnamedWardKeyVerified ~= true
      and getgenv().UnnamedWardGateClosed ~= true
      and (tick() - startT) < HARD_CAP do
        task.wait(0.1)
        if (tick() - startT) > SOFT_CAP and not getgenv().UnnamedWardGateClosed then
            warn("[UnnamedWard] Key gate unresponsive after " .. SOFT_CAP .. "s; bailing out.")
            getgenv().UnnamedWardGateClosed = true
            break
        end
    end
    local verified = getgenv().UnnamedWardKeyVerified == true
    local tier     = getgenv().UnnamedWardTier or "FREE"
    if type(tier) ~= "string" then tier = "FREE"
    else
        tier = tier:gsub("%s+", ""):upper()
        if tier ~= "PREMIUM" then tier = "FREE" end
    end
    return verified, tier
end

local keyVerified, premiumTier = runKeyGate()
if not keyVerified then
    warn("[UnnamedWard] Key gate closed without verification. Main script will NOT load.")
    return
end

getgenv().UnnamedWardBase      = BASE
getgenv().UnnamedWardTier      = premiumTier
