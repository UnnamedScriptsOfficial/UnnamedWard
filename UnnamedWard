		local c1 = espToggleColor(HealthBar, 1, Color3.fromRGB(0, 255, 0))
		local c2 = espToggleColor(HealthBar, 2, Color3.fromRGB(255, 255, 0))
		local c3 = espToggleColor(HealthBar, 3, Color3.fromRGB(255, 0, 0))
		if percent >= 0.5 then
