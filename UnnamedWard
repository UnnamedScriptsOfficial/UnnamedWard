    previewBox.Size = UDim2.new(0, isMobile and 60 or 80, 0, isMobile and 70 or 90)
    previewBox.Position = UDim2.new(0.5, isMobile and -30 or -40, 0, 20)
    previewBox.BackgroundColor3 = Theme.InnerCanvasBg
    previewBox.BorderSizePixel = 0
    previewBox.ZIndex = 3
    previewBox.Parent = previewFrame

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Color = Theme.AccentPink
    boxStroke.Thickness = 1.2
    boxStroke.Parent = previewBox

    local sampleName = Instance.new("TextLabel")
    sampleName.Size = UDim2.new(1, 0, 0, 12)
    sampleName.Position = UDim2.new(0, 0, 0, 2)
    sampleName.BackgroundTransparency = 1
    sampleName.Font = MainFont
    sampleName.Text = parentPlayer.DisplayName
    sampleName.TextColor3 = Theme.TextWhite
    sampleName.TextSize = isMobile and 8 or 9
    sampleName.ZIndex = 4
    sampleName.Parent = previewBox

    local sampleHp = Instance.new("Frame")
    sampleHp.Size = UDim2.new(0.8, 0, 0, 4)
    sampleHp.Position = UDim2.new(0, 8, 0, 16)
    sampleHp.BackgroundColor3 = Theme.Green
    sampleHp.BorderSizePixel = 0
    sampleHp.ZIndex = 4
    sampleHp.Parent = previewBox

    local sampleDist = Instance.new("TextLabel")
    sampleDist.Size = UDim2.new(1, 0, 0, 12)
    sampleDist.Position = UDim2.new(0, 0, 0, 22)
    sampleDist.BackgroundTransparency = 1
    sampleDist.Font = MainFont
    sampleDist.Text = "32m"
    sampleDist.TextColor3 = Theme.AccentPink
    sampleDist.TextSize = isMobile and 8 or 9
    sampleDist.ZIndex = 4
    sampleDist.Parent = previewBox

    local sampleDot = Instance.new("Frame")
    sampleDot.Size = UDim2.new(0, 3, 0, 3)
    sampleDot.Position = UDim2.new(0.5, 0, 0, 38)
    sampleDot.BackgroundColor3 = Theme.AccentPinkLight
    sampleDot.BorderSizePixel = 0
    sampleDot.ZIndex = 4
    sampleDot.Parent = previewBox
    Instance.new("UICorner", sampleDot).CornerRadius = UDim.new(1, 0)

    return {
        frame = previewFrame,
        box = previewBox,
        update = function(name, hp, dist, visible)
            sampleName.Text = name or parentPlayer.DisplayName
            sampleHp.Size = UDim2.new(math.clamp(hp or 1, 0, 1), 0, 0, 4)
            sampleDist.Text = tostring(math.floor(dist or 0)) .. "m"
            previewFrame.Visible = visible
        end
    }
end

-- Store previews per player
local espPreviews = {}
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        espPreviews[p] = createESPLivePreview(p)
    end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then
        espPreviews[p] = createESPLivePreview(p)
    end
end)
Players.PlayerRemoving:Connect(function(p)
    if espPreviews[p] then
        espPreviews[p].frame:Destroy()
        espPreviews[p] = nil
    end
end)

