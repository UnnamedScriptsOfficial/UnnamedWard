    lbl.Parent = container

    local box = Instance.new("TextButton")
    box.Size = UDim2.new(1, 0, 0, isMobile and 24 or 20)
    box.Position = UDim2.new(0, 0, 0, isMobile and 14 or 14)
    box.BackgroundColor3 = Theme.ControlBg
