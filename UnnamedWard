			queuedESPRefresh = true
			task.delay(0.15, function()
				queuedESPRefresh = false
				refreshESP(true)
			end)
			return
		end
		refreshingESP = true

		for _, connection in ipairs(ESP.Connections) do
			pcall(function() connection:Disconnect() end)
		end
		table.clear(ESP.Connections)
		ESP.Function(false)

		if ESP.Enabled then
