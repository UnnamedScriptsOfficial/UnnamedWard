local KEY_BASE = "https://raw.githubusercontent.com/UnnamedScriptsOfficial/UnnamedWard/refs/heads/main/"
local KEY_GATE_URL = KEY_BASE .. "keysystem.lua"

local gateOk = false
local gateTier = "FREE"

do
    if type(loadstring) ~= "function" then
        warn("[UnnamedWard] loadstring unavailable - cannot run key gate.")
        return
    end

    local fetchOk, src = pcall(function() return game:HttpGet(KEY_GATE_URL) end)
    if not fetchOk or type(src) ~= "string" or #src < 100 then
        warn("[UnnamedWard] Failed to fetch keysystem.lua.")
        return
    end

    getgenv().UnnamedWardBase = KEY_BASE
    getgenv().UnnamedWardGateCtx = {
        KeyVerified = false,
        GateClosed  = false,
        Tier        = "FREE",
    }
    getgenv().UnnamedWardKeyVerified = false
    getgenv().UnnamedWardPremium     = false
    getgenv().UnnamedWardTier        = "FREE"
    getgenv().UnnamedWardGateClosed  = false

    local fn, compileErr = loadstring(src)
    if not fn then
        warn("[UnnamedWard] keysystem.lua compile error: " .. tostring(compileErr))
        return
    end

    local runOk, runErr = pcall(fn)
    if not runOk then
        warn("[UnnamedWard] keysystem.lua runtime error: " .. tostring(runErr))
        return
    end

    local startT, HARD_CAP, SOFT_CAP = tick(), 1800, 300
    while getgenv().UnnamedWardKeyVerified ~= true
      and getgenv().UnnamedWardGateClosed ~= true
      and (tick() - startT) < HARD_CAP do
        task.wait(0.1)
        if (tick() - startT) > SOFT_CAP and not getgenv().UnnamedWardGateClosed then
            warn("[UnnamedWard] Key gate unresponsive after " .. SOFT_CAP .. "s; bailing out.")
            getgenv().UnnamedWardGateClosed = true
            break
        end
    end

    gateOk = getgenv().UnnamedWardKeyVerified == true
    gateTier = getgenv().UnnamedWardTier or "FREE"
    if type(gateTier) ~= "string" then
        gateTier = "FREE"
    else
        gateTier = gateTier:gsub("%s+", ""):upper()
        if gateTier ~= "PREMIUM" then gateTier = "FREE" end
    end
end

if not gateOk then
    warn("[UnnamedWard] Key verification failed. Script aborted.")
    return
end

