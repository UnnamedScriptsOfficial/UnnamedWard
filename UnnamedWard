local function serializeConfig(v)
    if typeof(v) == "EnumItem" then
        return {__enum = tostring(v.EnumType), __name = v.Name}
    elseif typeof(v) == "Color3" then
        return {__color = {v.R, v.G, v.B}}
    elseif type(v) == "table" then
        local t = {}
        for k, vv in pairs(v) do t[k] = serializeConfig(vv) end
        return t
    end
    return v
end

local function deserializeConfig(v)
    if type(v) == "table" then
        if v.__enum and v.__name then
            local enumType = Enum[v.__enum]
            if enumType then return enumType[v.__name] end
            return nil
        elseif v.__color then
            return Color3.new(v.__color[1], v.__color[2], v.__color[3])
        end
        local out = {}
        for k, vv in pairs(v) do out[k] = deserializeConfig(vv) end
        return out
    end
    return v
end

