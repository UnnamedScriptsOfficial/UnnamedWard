local Tracers = {}
do
    function Tracers.CreateTracer(origin, target, color, texture)
        if not origin or not target then return end
        pcall(function()
            local dist = (target - origin).Magnitude
            if dist < 3 or dist > 1500 then return end
            local a0 = Instance.new("Attachment"); a0.Position = origin
            local a1 = Instance.new("Attachment"); a1.Position = target
            a0.Parent = Workspace.Terrain; a1.Parent = Workspace.Terrain
            local beam = Instance.new("Beam")
            beam.Attachment0 = a0; beam.Attachment1 = a1
            beam.Width0 = 0.06; beam.Width1 = 0.06
            beam.FaceCamera = true; beam.LightEmission = 1; beam.LightInfluence = 0
            beam.Color = ColorSequence.new(color or Theme.AccentPinkLight)
            beam.Transparency = NumberSequence.new(0)
            beam.Texture = texture or ''
            beam.TextureSpeed = 5
            beam.Parent = Workspace.Terrain
            task.delay(0.4, function()
                if a0.Parent then a0:Destroy() end
                if a1.Parent then a1:Destroy() end
                if beam.Parent then beam:Destroy() end
            end)
        end)
    end

    function Tracers.CreateImpact(pos, color)
        pcall(function()
            if not pos then return end
            local part = Instance.new("Part")
            part.Size = Vector3.new(0.2, 0.2, 0.2); part.Position = pos
            part.Anchored = true; part.CanCollide = false
            part.Material = Enum.Material.Neon; part.Color = color or Theme.AccentPink
            part.Parent = Workspace.Terrain
            task.delay(0.6, function() if part.Parent then part:Destroy() end end)
        end)
    end
end

