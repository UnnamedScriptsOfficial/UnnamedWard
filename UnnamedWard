local KillManager = {}
do
    function KillManager.KillAll()
        local rem = ReplicatedStorage:FindFirstChild("Remotes")
        if not rem then return end
        for _, sub in ipairs(rem:GetDescendants()) do
            if sub:IsA("RemoteEvent") and sub.Name:lower():find("damage") then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            pcall(function() sub:FireServer(p.Character, 9999) end)
                        end
                    end
                end
            end
        end
    end

    function KillManager.KillPriority(targetPlayer)
        if not targetPlayer or not targetPlayer.Character then return end
        local rem = ReplicatedStorage:FindFirstChild("Remotes")
        if not rem then return end
        for _, sub in ipairs(rem:GetDescendants()) do
            if sub:IsA("RemoteEvent") and sub.Name:lower():find("damage") then
                pcall(function() sub:FireServer(targetPlayer.Character, 9999) end)
            end
        end
    end
end

