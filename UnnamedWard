-- ============================================================
local keyVerified = false
local premiumTier = "FREE"

-- Set up the context table that keysystem.lua will read/write to
local gateCtx = {
    Wishlist = WISHLIST_URL,
    Blacklist = BLACKLIST_URL,
    Free = FREE_URL,
    Discord = DISCORD_INVITE,
    PlayerGui = PlayerGui,
    Theme = Theme,
    MainFont = MainFont,
    isMobile = isMobile,
    SavedKey = nil,

    -- Signals the main script waits on
    KeyVerified = false,
    GateClosed = false,
    Tier = "FREE",
}

-- Expose globals that keysystem.lua may check
getgenv().UnnamedWardGateCtx = gateCtx
getgenv().UnnamedWardKeyVerified = false
getgenv().UnnamedWardPremium = false
getgenv().UnnamedWardTier = "FREE"
getgenv().UnnamedWardGateClosed = false

-- Fetch and run the key gate script
do
    if type(loadstring) ~= "function" then
        warn("[UnnamedWard] loadstring unavailable -- cannot open key gate.")
        getgenv().UnnamedWardGateClosed = true
        gateCtx.GateClosed = true
    else
        local fetchOk, src = pcall(function() return game:HttpGet(KEY_GATE_URL) end)
        if not fetchOk or type(src) ~= "string" or #src < 100 then
            warn("[UnnamedWard] Could not fetch key gate source.")
            getgenv().UnnamedWardGateClosed = true
            gateCtx.GateClosed = true
        else
            local fn, compileErr = loadstring(src)
            if not fn then
                warn("[UnnamedWard] Key gate compile error: " .. tostring(compileErr))
                getgenv().UnnamedWardGateClosed = true
                gateCtx.GateClosed = true
            else
                -- Give the gate script its context FIRST
                -- The keysystem.lua should read getgenv().UnnamedWardGateCtx
                local runOk, runErr = pcall(fn)
                if not runOk then
                    warn("[UnnamedWard] Key gate runtime error: " .. tostring(runErr))
                end
            end
        end
    end
end

-- ============================================================
-- WAIT FOR KEY VERIFICATION (with hard timeout)
-- ============================================================
do
    local startT = tick()
    local HARD_CAP = 1800   -- 30 min absolute max
    local SOFT_CAP = 300    -- 5 min warn threshold

    while not keyVerified
       and getgenv().UnnamedWardKeyVerified ~= true
       and getgenv().UnnamedWardGateClosed ~= true
       and (tick() - startT) < HARD_CAP do
        task.wait(0.1)
        if (tick() - startT) > SOFT_CAP and not getgenv().UnnamedWardGateClosed then
            warn("[UnnamedWard] Key gate unresponsive after " .. SOFT_CAP .. "s; bailing out.")
            getgenv().UnnamedWardGateClosed = true
            break
        end
    end
end

-- Resolve tier
keyVerified = getgenv().UnnamedWardKeyVerified == true
premiumTier = getgenv().UnnamedWardTier or "FREE"

if type(premiumTier) ~= "string" then
    premiumTier = "FREE"
elseif premiumTier:upper() ~= "PREMIUM" then
    premiumTier = "FREE"
else
    premiumTier = "PREMIUM"
end

-- If the key gate closed without verification, abort
if not keyVerified then
    warn("[UnnamedWard] Key gate closed without verification. Main script will NOT load.")
    return
end

print("[UnnamedWard] Key verified! Tier: " .. tostring(premiumTier))
print("[UnnamedWard] Loading main script...")

